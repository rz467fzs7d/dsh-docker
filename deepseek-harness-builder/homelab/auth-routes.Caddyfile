	route /auth* {
		respond @untrusted_host "Forbidden" 403
		respond @unexpected_origin "Forbidden" 403
		rate_limit {
			zone dsh_auth_usernames {
				match {
					method POST
					path /auth/login
				}
				key {http.vars.client_ip}
				window 1m
				events 10
				ipv6_prefix 64
			}
			zone dsh_auth_passwords {
				match {
					method POST
					path /auth/sandbox/*
				}
				key {http.vars.client_ip}
				window 10m
				events 10
				ipv6_prefix 64
			}
		}
		header Cache-Control "no-store"
		authenticate with dsh_portal
	}
